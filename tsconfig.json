{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
		"src/**/*.ts",
		"src/**/*.tsx"
  ]
}

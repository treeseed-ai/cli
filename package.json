{
  "name": "@treeseed-cordis/cli",
  "version": "0.0.0-cordis.9",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "check": "bun run check:test-layout && bun scripts/build-cli.ts check",
    "build": "bun scripts/build-cli.ts build",
    "test:unit": "bun test ./tests/unit --pass-with-no-tests",
    "test:integration": "bun test ./tests/integration --timeout 30000",
    "test:smoke": "bun run test:acceptance",
    "verify": "bun run check && bun run build && bun run test:acceptance && bun run test:regression && bun run test:integration && bun run test:unit",
    "check:test-layout": "bun .agents/skills/release-workflow/scripts/test-layout.ts",
    "test:regression": "bun test ./tests/regression",
    "test:acceptance": "bun test ./tests/acceptance --timeout 60000"
  },
  "dependencies": {
    "@treeseed-cordis/sdk": "file:vendor/sdk.tgz",
    "@treeseed-cordis/deployment": "file:vendor/deployment.tgz",
    "jsonc-parser": "3.3.1",
    "@treeseed-cordis/ui": "file:vendor/ui.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.10.1",
    "cordis": "4.0.0-rc.12",
    "typescript": "5.9.3"
  },
